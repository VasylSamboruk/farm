# Local values only. Configure production values in Railway Variables.
MONGO_URI=mongodb://127.0.0.1:27017/farmgame
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:5173
PORT=5000
NODE_ENV=development
# Optional: comma-separated usernames promoted to admin on successful login.
ADMIN_USERNAMES=first-admin-login,second-admin-login
# Optional initial public asset base; it can also be set in the admin media page.
R2_PUBLIC_BASE_URL=https://your-r2-public-or-custom-domain/
